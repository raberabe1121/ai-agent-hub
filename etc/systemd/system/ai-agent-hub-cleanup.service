[Unit]
Description=AI Agent Hub Cleanup

[Service]
Type=oneshot
WorkingDirectory=/opt/ai-agent-hub
ExecStart=/opt/ai-agent-hub/venv/bin/python -m ai_agent_hub.cleanup --hours 24
User=opc
Group=opc
Environment=AI_AGENT_HUB_PROCESSED_DIR=/opt/ai-agent-hub/processed

Environment=AI_AGENT_HUB_RETENTION_HOURS=24
